
# Smart QR Visitor Management System
# Template only: copy to .env for local development.
# Never commit your real .env file to version control.

# --------------------------------------------------
# Application environment
# --------------------------------------------------
FLASK_APP=run.py
FLASK_ENV=development
APP_ENV=development
DEBUG=true

# --------------------------------------------------
# Security
# --------------------------------------------------
# Replace this placeholder with a long, randomly generated secret.
# Do not use this placeholder as a real secret.
SECRET_KEY=replace-with-a-long-random-secret-before-running

# Set secure cookies to true when running behind HTTPS in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# --------------------------------------------------
# Database
# --------------------------------------------------
# Example SQLite database path.
# Configure the application to resolve this path safely.
DATABASE_URL=sqlite:///visitor_management.db

# --------------------------------------------------
# QR credential settings
# --------------------------------------------------
# Default validity period for issued visit credentials.
QR_VALIDITY_MINUTES=120

# Allow QR credential reissue only through the authorized workflow.
QR_ALLOW_REISSUE=true

# --------------------------------------------------
# Time and locale
# --------------------------------------------------
APP_TIMEZONE=Asia/Kolkata

# Store authoritative timestamps in UTC.
# Use APP_TIMEZONE for display and local-time interpretation.

# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_LEVEL=INFO

# --------------------------------------------------
# Optional email settings
# Leave unset until email notifications are implemented.
# Never place real credentials in this example file.
# --------------------------------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --------------------------------------------------
# Optional SMS provider
# Configure only if SMS integration is approved.
# --------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=

# --------------------------------------------------
# Rate Limiting Settings
# --------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_APPROVAL=30/minute
RATE_LIMIT_GATE=60/minute

# --------------------------------------------------
# Reverse Proxy & Production Deployment Configuration
# --------------------------------------------------
# When running behind an upstream reverse proxy (e.g. Nginx, Caddy, AWS ALB):
# Set SESSION_COOKIE_SECURE=true to mandate HTTPS.
# Configure trusted proxy IP extraction rather than blindly trusting X-Forwarded-For.
BEHIND_PROXY=false
TRUSTED_PROXIES=127.0.0.1

# --------------------------------------------------
# Public Registration & Pass Canonical Base URL
# --------------------------------------------------
# Canonical base URL for generated visitor registration forms and shareable passes.
#
# Local Development:
#   Leave blank or set to: http://localhost:5000 (falls back automatically to the request host).
#
# Production Deployment (e.g. Vercel):
#   Set to your verified public domain with HTTPS, e.g.:
#   PUBLIC_BASE_URL=https://your-project.vercel.app
#
# Why this matters:
#   - In production, this guarantees generated visitor links use HTTPS and your canonical public domain.
#   - Prevents leaking internal preview URLs, localhost, or 127.0.0.1 in visitor-facing registration links.
#   - Allows visitors on mobile devices and external networks to open the registration form without login.
PUBLIC_BASE_URL=

